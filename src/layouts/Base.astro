---
import { rubriques } from '../data/rubriques';
import { url, lienRubrique } from '../data/url';
import '../styles/revue.css';

interface Props { title?: string; description?: string; }
const { title, description = "Thierry Brenet, rédacteur et journaliste indépendant à Besançon." } = Astro.props;
const pageTitle = title ? `${title} — Thierry Brenet` : 'Thierry Brenet — la revue';
const avion = `<g fill="none" stroke="#c1272d" stroke-linejoin="round" stroke-linecap="round"><path d="M12 50 L88 16 L60 86 L50 60 Z"/><path d="M50 60 L88 16"/></g>`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;0,6..96,900;1,6..96,500;1,6..96,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="filet"></div>
  <header>
    <div class="wrap">
      <div class="head-top">
        <a class="brandline" href={url()}>
          <svg class="plane" viewBox="0 0 100 100" aria-hidden="true" stroke-width="7" set:html={avion} />
          <span class="name">Thierry Brenet</span>
        </a>
        <div class="meta-plate">Besançon<br>Rédacteur · Journaliste<br>Curieux de tout</div>
      </div>
      <nav aria-label="Rubriques">
        {rubriques.filter((r) => r.nav).map((r) => <a href={lienRubrique(r.slug)}>{r.label}</a>)}
      </nav>
    </div>
  </header>

  <div class="wrap">
    <div class="ghost" aria-hidden="true">
      <svg viewBox="0 0 100 100" stroke-width="6" set:html={avion} />
    </div>
    <main><slot /></main>
  </div>

  <footer>
    <div class="filet"></div>
    <div class="fwrap">
      <span class="sig">Redresser les vétilles — quel que soit le pays, l'époque ou la personne.</span>
      <span class="c"><svg class="plane-sm" viewBox="0 0 100 100" aria-hidden="true" stroke-width="8" set:html={avion} /> © Thierry Brenet · Besançon</span>
    </div>
  </footer>
</body>
</html>

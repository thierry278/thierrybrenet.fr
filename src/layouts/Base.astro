---
import { rubriques } from '../data/rubriques';
import { url, lienRubrique } from '../data/url';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/inter';
import '../styles/revue.css';

interface Props { title?: string; description?: string; image?: string; date?: Date; }
const { title, image: ogImage, date, description = "Thierry Brenet, rédacteur et journaliste indépendant à Besançon." } = Astro.props;
const pageTitle = title ? `${title} — Thierry Brenet` : 'Thierry Brenet — la revue';
const avion = `<g fill="none" stroke="#a3361d" stroke-linejoin="round" stroke-linecap="round"><path d="M12 50 L88 16 L60 86 L50 60 Z"/><path d="M50 60 L88 16"/></g>`;
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex">
  <meta property="og:type" content={title ? 'article' : 'website'}>
  <meta property="og:title" content={title ?? 'Thierry Brenet'}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)}>
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)}>}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <link rel="sitemap" href={new URL('sitemap-index.xml', new URL(import.meta.env.BASE_URL, Astro.site))}>
  {date && <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
    datePublished: date.toISOString().slice(0, 10),
    image: ogImage ? [new URL(ogImage, Astro.site).href] : undefined,
    author: { '@type': 'Person', name: 'Thierry Brenet', url: new URL(import.meta.env.BASE_URL, Astro.site).href },
  })} />}
</head>
<body>
  <div class="filet"></div>
  <header>
    <div class="wrap">
      <div class="head-top">
        <a class="titre-site" href={url()}>Thierry Brenet</a>
        <a class="logo" href={url()}><img src={url('images/logo-thierrybrenet.png').replace(/\/$/, '')} alt="Thierrybrenet.fr" width="544" height="265"></a>
        <div class="signature">
          <span>Journaliste indépendant</span>
          <span>Auteur et serial writer</span>
        </div>
      </div>
      <nav aria-label="Rubriques">
        {rubriques.filter((r) => r.nav).map((r) => <a href={lienRubrique(r.slug)}>{r.label}</a>)}
        <a class="apropos" href={url('a-propos/')}>À propos</a>
      </nav>
    </div>
  </header>

  <div class="wrap">
    <div class="ghost" aria-hidden="true">
      <img src={url('images/avion.png').replace(/\/$/, '')} alt="">
    </div>
    <main><slot /></main>
  </div>

  <footer>
    <div class="filet"></div>
    <div class="fwrap">
      <span class="sig">Redresser les vétilles — quel que soit le pays, l'époque ou la personne.</span>
      <span class="liens"><a href={url('contact/')}>Contact</a><a href={url('mentions-legales/')}>Mentions légales</a></span>
      <span class="c"><svg class="plane-sm" viewBox="0 0 100 100" aria-hidden="true" stroke-width="8" set:html={avion} /> © Thierry Brenet · Besançon</span>
    </div>
  </footer>
</body>
</html>

---
import { rubrique } from '../data/rubriques';
import { lienArticle, image } from '../data/url';
const { article } = Astro.props;
const d = article.data;
const visuel = image(d.vignette) ?? image(d.image) ?? (d.youtube ? `https://i.ytimg.com/vi/${d.youtube}/hqdefault.jpg` : undefined);
---
<a class="card" href={lienArticle(article)}>
  {visuel && <img class="card-img" src={visuel} alt="" loading="lazy" />}
  <span class="cat">{rubrique(d.rubrique)?.singulier}</span>
  <h2>{d.title}</h2>
  <p>{d.dek}</p>
  <span class="foot">{d.format}{d.minutes ? ` · ${d.minutes} min` : ''}</span>
</a>

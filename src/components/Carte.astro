---
import { rubrique } from '../data/rubriques';
import { lienArticle, image } from '../data/url';
import { series, episodes } from '../data/series';
const { article } = Astro.props;
const d = article.data;
const carte = image(d.carte);            // infographie : visuel entier, format naturel
const visuel = carte ?? image(d.vignette) ?? image(d.image);
const serie = d.serie ? series[d.serie] : undefined;
const nbEpisodes = d.serie ? (await episodes(d.serie)).length : 0;
---
<a class="card" href={lienArticle(article)}>
  {visuel && <img class={carte ? "card-img card-img--entiere" : "card-img"} src={visuel} alt="" loading="lazy" />}
  <span class="cat">{rubrique(d.rubrique)?.singulier}</span>
  <h2>{serie ? serie.titre : d.title}</h2>
  <p>{d.dek}</p>
  <span class="foot">{serie ? `Série · ${nbEpisodes} épisodes` : `${d.format}${d.minutes ? ` · ${d.minutes} min` : ''}`}</span>
</a>

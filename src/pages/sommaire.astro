---
import Base from '../layouts/Base.astro';
import Carte from '../components/Carte.astro';
import { regrouper } from '../data/series';
import { articlesPublies } from '../data/articles';
const liste = await regrouper(await articlesPublies());
---
<Base title="Sommaire">
  <section class="fil">
    <div class="fil-head"><span class="eyebrow">Tout le sommaire</span><span class="all">{liste.length} publications</span></div>
    <div class="grid">{liste.map((a) => <Carte article={a} />)}</div>
  </section>
</Base>
